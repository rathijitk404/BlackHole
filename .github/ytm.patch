''')
rw(H, lambda s: (lambda p: p[0] + "drawer: Drawer(\nwidth: MediaQuery.sizeOf(context).width,\nshape: const RoundedRectangleBorder(),\n" + p[1].replace("automaticallyImplyLeading: false,", "automaticallyImplyLeading: false,\nactions: [\nIconButton(\nicon: const Icon(Icons.close_rounded),\niconSize: 30,\nonPressed: () => Navigator.pop(context),\n),\nconst SizedBox(width: 8),\n],", 1))(s.split("drawer: Drawer(", 1)))
pts = [(218, 1), (205, 1), (90, 25), (78, 26), (72, 28), (67, 33), (65, 82), (66, 201), (64, 207), (59, 212), (22, 221), (11, 227), (6, 232), (0, 245), (0, 257), (4, 269), (14, 279), (25, 284), (47, 283), (58, 279), (67, 273), (73, 267), (78, 258), (80, 250), (80, 97), (86, 91), (92, 89), (125, 84), (196, 69), (203, 69), (206, 71), (208, 75), (207, 176), (204, 181), (197, 185), (173, 189), (155, 197), (149, 203), (143, 214), (143, 230), (148, 242), (156, 250), (166, 254), (186, 254), (197, 252), (208, 246), (215, 239), (220, 230), (222, 221), (223, 36), (222, 6)]
mask = lambda wd, h: np.array((lambda m: ([ImageDraw.Draw(m).polygon([(x * wd * 3 / 224, y * h * 3 / 285) for x, y in pts], fill=255)], m.resize((wd, h), Image.LANCZOS))[1])(Image.new('L', (wd * 3, h * 3), 0))).astype(float) / 255
note = lambda h: (lambda wd: Image.fromarray(np.dstack([np.full((h, wd, 3), 255.0), mask(wd, h) * 255]).astype(np.uint8)))(round(h * 224 / 285))
onbg = lambda sz, f, bg: (lambda w: (bg.alpha_composite(w, ((sz - w.width) // 2, (sz - w.height) // 2)), bg)[1])(note(round(f * sz)))
square = lambda sz: onbg(sz, 0.5, Image.new('RGBA', (sz, sz), (0, 0, 0, 255)))
circ = lambda sz: (lambda m: (ImageDraw.Draw(m).ellipse((0, 0, sz - 1, sz - 1), fill=255), m)[1])(Image.new('L', (sz, sz), 0))
rnd = lambda sz: (lambda im: (im.putalpha(circ(sz)), im)[1])(square(sz))
dens = {'mdpi': 48, 'hdpi': 72, 'xhdpi': 96, 'xxhdpi': 144, 'xxxhdpi': 192}
FG = {'mdpi': 108, 'hdpi': 162, 'xhdpi': 216, 'xxhdpi': 324, 'xxxhdpi': 432}
R = 'android/app/src/main/res/'
[square(v).save(R + 'mipmap-' + k + '/ic_launcher.png') for k, v in dens.items()]
[rnd(v).save(R + 'mipmap-' + k + '/ic_launcher_round.png') for k, v in dens.items()]
[onbg(v, 0.45, Image.new('RGBA', (v, v), (0, 0, 0, 0))).save(R + 'mipmap-' + k + '/ic_launcher_foreground.png') for k, v in FG.items()]
square(512).save('assets/ic_launcher.png')
bg4 = onbg(400, 0.75, Image.new('RGBA', (400, 400), (0, 0, 0, 0)))
bg4.putalpha(bg4.getchannel('A').point(lambda v: v // 2))
bg4.save('assets/icon-white-trans.png')
t = open(H, encoding='utf-8').read()
