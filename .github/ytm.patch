set -e
python3 -m pip install -q pillow numpy 2>/dev/null || python3 -m pip install -q --break-system-packages pillow numpy 2>/dev/null || true
python3 - <<'PYEOF'
import re
import numpy as np
from PIL import Image, ImageDraw
rw = lambda p, f: (lambda s: open(p, 'w', encoding='utf-8').write(s))(f(open(p, encoding='utf-8').read()))
X = 'lib/Services/ext_storage_provider.dart'
D = 'lib/Services/download.dart'
S = 'lib/Screens/Search/search.dart'
rw(X, lambda s: s.replace("if (await requestPermission(Permission.storage)) {", "if (await Permission.manageExternalStorage.isGranted || await requestPermission(Permission.storage)) {", 1).replace("return throw 'something went wrong';", "return (await getExternalStorageDirectory())!.path;", 1))
rw(D, lambda s: s.replace("if (Platform.isAndroid || Platform.isIOS) {", "if (Platform.isIOS) {", 1))
rw(S, lambda s: re.sub(r"top: 70,", "top: 118,", re.sub(r"\{'label': 'Saavn', 'key': 'saavn'\},", "", s, count=1), count=1))
SOLID = [[(54, 12), (155, 0), (155, 40), (54, 49)], [(54, 12), (62, 12), (62, 137), (54, 137)], [(147, 0), (155, 0), (155, 110), (147, 110)]]
RINGS = [(31, 137, 31, 28), (124, 110, 31, 28)]
INNER = [(31, 137, 23, 20), (124, 110, 23, 20)]
HOLE = [(62, 18), (147, 10), (147, 31), (62, 38)]
def mask(wd, h): K = 8; m = Image.new('L', (wd * K, h * K), 0); d = ImageDraw.Draw(m); sx = wd * K / 156; sy = h * K / 166; [d.polygon([(x * sx, y * sy) for x, y in P], fill=255) for P in SOLID]; [d.ellipse([(cx - rx) * sx, (cy - ry) * sy, (cx + rx) * sx, (cy + ry) * sy], fill=255) for cx, cy, rx, ry in RINGS]; [d.ellipse([(cx - rx) * sx, (cy - ry) * sy, (cx + rx) * sx, (cy + ry) * sy], fill=0) for cx, cy, rx, ry in INNER]; d.polygon([(x * sx, y * sy) for x, y in HOLE], fill=0); return np.array(m.resize((wd, h), Image.LANCZOS))
note = lambda h: (lambda wd: Image.fromarray(np.dstack([np.full((h, wd, 3), 255, dtype=np.uint8), mask(wd, h)])))(round(h * 156 / 166))
onbg = lambda sz, f, bg: (lambda w: (bg.alpha_composite(w, ((sz - w.width) // 2, (sz - w.height) // 2)), bg)[1])(note(round(f * sz)))
square = lambda sz: onbg(sz, 0.46, Image.new('RGBA', (sz, sz), (0, 0, 0, 255)))
circ = lambda sz: (lambda m: (ImageDraw.Draw(m).ellipse((0, 0, sz - 1, sz - 1), fill=255), m)[1])(Image.new('L', (sz, sz), 0))
rnd = lambda sz: (lambda im: (im.putalpha(circ(sz)), im)[1])(square(sz))
dens = {'mdpi': 48, 'hdpi': 72, 'xhdpi': 96, 'xxhdpi': 144, 'xxxhdpi': 192}
FG = {'mdpi': 108, 'hdpi': 162, 'xhdpi': 216, 'xxhdpi': 324, 'xxxhdpi': 432}
R = 'android/app/src/main/res/'
[square(v).save(R + 'mipmap-' + k + '/ic_launcher.png') for k, v in dens.items()]
[rnd(v).save(R + 'mipmap-' + k + '/ic_launcher_round.png') for k, v in dens.items()]
[onbg(v, 0.4, Image.new('RGBA', (v, v), (0, 0, 0, 0))).save(R + 'mipmap-' + k + '/ic_launcher_foreground.png') for k, v in FG.items()]
square(1024).save('assets/ic_launcher.png')
bg4 = onbg(800, 0.7, Image.new('RGBA', (800, 800), (0, 0, 0, 0)))
bg4.putalpha(bg4.getchannel('A').point(lambda v: v // 2))
bg4.save('assets/icon-white-trans.png')
x = open(X, encoding='utf-8').read()
d = open(D, encoding='utf-8').read()
s = open(S, encoding='utf-8').read()
assert 'manageExternalStorage.isGranted ||' in x and 'getExternalStorageDirectory())!.path;' in x, 'storage edit failed'
assert d.count('if (Platform.isIOS) {') >= 1 and 'Permission.storage.status' in d, 'download edit failed'
assert "'label': 'Saavn'" not in s and 'top: 118,' in s, 'search edit failed'
print('ALL EDITS OK')
PYEOF
git add -A
git commit -q -m "Fix downloads, hide source chip, smaller crisp icon" && echo COMMITTED
echo DONE