import os
import numpy as np
from PIL import Image, ImageDraw
rw = lambda p, f: (lambda s: open(p, 'w', encoding='utf-8').write(s))(f(open(p, encoding='utf-8').read()))
H = 'lib/Screens/Home/home.dart'
open('lib/CustomWidgets/credit_banner.dart', 'w', encoding='utf-8').write(r'''import 'package:flutter/material.dart';

