set -e
python3 - <<'PYEOF'
rw = lambda p, f: (lambda s: open(p, 'w', encoding='utf-8').write(s))(f(open(p, encoding='utf-8').read()))
G = 'android/app/build.gradle'
A = 'lib/providers/audio_service_provider.dart'
E = 'lib/Services/ext_storage_provider.dart'
rw(G, lambda s: s.replace('applicationId = "org.brightdv.blackhole"', 'applicationId = "com.rathijitx.music"', 1))
rw(A, lambda s: s.replace("'org.brightdv.blackhole.channel.audio'", "'com.rathijitx.music.channel.audio'", 1))
rw(E, lambda s: s.replace("Android/data/org.brightdv.blackhole/files", "Android/data/com.rathijitx.music/files", 1))
g = open(G, encoding='utf-8').read()
assert 'applicationId = "com.rathijitx.music"' in g and 'namespace = "org.brightdv.blackhole"' in g, 'gradle edit failed'
assert 'com.rathijitx.music.channel.audio' in open(A, encoding='utf-8').read() and 'Android/data/com.rathijitx.music/files' in open(E, encoding='utf-8').read(), 'dart edit failed'
print('ALL EDITS OK')
PYEOF
git add -A
git commit -q -m "New package name com.rathijitx.music" && echo COMMITTED
echo DONE